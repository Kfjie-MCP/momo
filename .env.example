# Direct values are convenient for local development. Production can instead use
# MAIMEMO_API_TOKEN_FILE and MCP_BEARER_TOKEN_FILE.
MAIMEMO_API_TOKEN=
MAIMEMO_API_TOKEN_FILE=

MCP_BEARER_TOKEN=
MCP_BEARER_TOKEN_FILE=

# server: optional separate MCP bearer + server-side MaiMemo token
# maimemo-token: request Bearer token is the MaiMemo API token
AUTH_MODE=maimemo-token

HOST=127.0.0.1
PORT=8787
MCP_PATH=/momo

# Comma-separated Host header allowlist for public binding, e.g. mcp.example.com
ALLOWED_HOSTS=

# Official MaiMemo/Markji writes are disabled by default. Local review reporting
# and daily observation snapshots are saved independently, without confirm.
ALLOW_MUTATIONS=false
CLI_TIMEOUT_MS=30000

# Optional SQLite path. By default uses STATE_DIRECTORY when set by systemd,
# otherwise XDG_STATE_HOME/momo-mcp or ~/.local/state/momo-mcp.
LOCAL_REVIEW_DB_PATH=
