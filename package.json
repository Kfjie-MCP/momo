{
  "name": "momo-mcp",
  "version": "0.3.1",
  "private": true,
  "description": "MaiMemo MCP server for study progress, review queues, user-created vocabulary content, and Markji cards.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kfjie-MCP/momo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@maimemo/memo-api": "1.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
